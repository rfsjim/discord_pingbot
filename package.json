{
  "name": "discord-ping-bot",
  "version": "0.12.0",
  "description": "A discord bot that reacts to pings",
  "homepage": "https://github.com/rfsjim/discord_pingbot#readme",
  "bugs": {
    "url": "https://github.com/rfsjim/discord_pingbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfsjim/discord_pingbot.git"
  },
  "license": "MPL-2.0",
  "author": "James",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "commands:deploy:guild": "node --env-file=.env scripts/deployCommands.js guild",
    "commands:deploy:global": "node --env-file=.env scripts/deployCommands.js global",
    "commands:deleteAll:guild": "node --env-file=.env scripts/deleteAllCommands.js guild",
    "commands:deleteAll:global": "node --env-file=.env scripts/deleteAllCommands.js global",
    "commands:delete:guild": "node --env-file=.env scripts/deleteCommands.js guild",
    "commands:delete:global": "node --env-file=.env scripts/deleteCommands.js global",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --project jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
